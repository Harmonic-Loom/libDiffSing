if(NOT DEFINED ENV{DIFFSING_MACOS_DEPLOYMENT_TARGET} OR "$ENV{DIFFSING_MACOS_DEPLOYMENT_TARGET}" STREQUAL "")
    message(FATAL_ERROR "DIFFSING_MACOS_DEPLOYMENT_TARGET is required")
endif()

set(VCPKG_TARGET_ARCHITECTURE x64)
set(VCPKG_CRT_LINKAGE dynamic)
set(VCPKG_LIBRARY_LINKAGE static)
set(VCPKG_CMAKE_SYSTEM_NAME Darwin)
set(VCPKG_OSX_ARCHITECTURES x86_64)
set(VCPKG_OSX_DEPLOYMENT_TARGET "$ENV{DIFFSING_MACOS_DEPLOYMENT_TARGET}")
set(VCPKG_ENV_PASSTHROUGH DIFFSING_MACOS_DEPLOYMENT_TARGET)
